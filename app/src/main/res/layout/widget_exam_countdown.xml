<?xml version="1.0" encoding="utf-8"?>
<!-- 2×2 考试倒计时：最近一场考试 + 剩余天数 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- 头部：点缀色竖线 + 标题（灰） + 共几场 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/exam_accent"
            android:layout_width="3dp"
            android:layout_height="14dp"
            android:layout_marginEnd="8dp"
            android:background="@color/widget_due_today" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="考试倒计时"
            android:textColor="@color/widget_text_dim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/exam_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 中间：考试名 + 大号天数，垂直居中把 2×2 撑满 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="4dp">

        <TextView
            android:id="@+id/exam_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:textColor="@color/widget_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/exam_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_due_today"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/exam_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="5dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_text_dim"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底部：课程名 + 考试日期 -->
    <TextView
        android:id="@+id/exam_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:textColor="@color/widget_text_dim"
        android:textSize="11sp" />
</LinearLayout>
