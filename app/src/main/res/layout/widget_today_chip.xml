<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2 里的一节课程：左侧细彩色竖线 + 课程名/地点（左），起止时间（右） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- 分类色竖线：只保留这一条细线，不再铺整块背景 -->
    <TextView
        android:id="@+id/card_accent"
        android:layout_width="3dp"
        android:layout_height="48dp"
        android:layout_marginEnd="11dp"
        android:background="#FFE8629B" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/card_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="@color/widget_card_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/card_room"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_card_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 右侧起止时间：开始更亮、结束更灰 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/card_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_card_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/card_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:textColor="@color/widget_card_dim"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
