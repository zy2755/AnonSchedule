<?xml version="1.0" encoding="utf-8"?>
<!-- 待办 DDL 里的一条：左侧方形勾选框 + 待办标题，右侧截止文案 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- 点这个方框直接在桌面标记完成，外框颜色代表紧急度 -->
    <ImageView
        android:id="@+id/todo_check"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="完成待办"
        android:src="@drawable/ic_widget_check_box" />

    <TextView
        android:id="@+id/todo_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_card_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/todo_due"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_card_dim"
        android:textSize="11sp" />
</LinearLayout>
