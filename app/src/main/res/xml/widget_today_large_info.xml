<?xml version="1.0" encoding="utf-8"?>
<!-- 4×4 今日课程小组件：可滚动的今日课程列表 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_desc"
    android:initialLayout="@layout/widget_today_large"
    android:minHeight="250dp"
    android:minWidth="300dp"
    android:previewImage="@drawable/widget_preview_large"
    android:previewLayout="@layout/widget_today_large"
    android:resizeMode="none"
    android:targetCellHeight="4"
    android:targetCellWidth="4"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
