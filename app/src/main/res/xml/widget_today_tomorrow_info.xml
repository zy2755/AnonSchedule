<?xml version="1.0" encoding="utf-8"?>
<!-- 4×4 今日·明日小组件：左右两列分别展示今天 / 明天的课 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_mt_desc"
    android:initialLayout="@layout/widget_today_tomorrow"
    android:minHeight="250dp"
    android:minWidth="300dp"
    android:previewImage="@drawable/widget_preview_mt"
    android:previewLayout="@layout/widget_today_tomorrow"
    android:resizeMode="none"
    android:targetCellHeight="4"
    android:targetCellWidth="4"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
